# VORTEX Money: one container = the consumer web app + its API.
#   docker build -f Dockerfile.money -t vortex-money .
#   docker run -p 8100:8100 -e MONEY_SECRET=$(openssl rand -hex 32) -v vortex-data:/data vortex-money
FROM node:22-slim AS web
WORKDIR /web
COPY app/package.json app/package-lock.json ./
RUN npm ci
COPY app/ ./
RUN npx vite build

FROM python:3.12-slim
WORKDIR /srv
RUN pip install --no-cache-dir "fastapi==0.142.*" "uvicorn[standard]" pydantic
COPY money_api/ money_api/
COPY --from=web /web/dist/ app/dist/
COPY app/public/money/engine.json app/public/money/engine.json
ENV MONEY_DB=/data/money.sqlite3 MONEY_DIST=/srv/app/dist MONEY_ENGINE=/srv/app/public/money/engine.json
RUN useradd -m app && mkdir -p /data && chown app /data
USER app
EXPOSE 8100
HEALTHCHECK CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8100/api/health')"
CMD ["uvicorn", "money_api.app:app", "--host", "0.0.0.0", "--port", "8100", "--proxy-headers"]
