{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# VORTEX-AI (CG-NSDE) - Google Colab Training\n",
        "\n",
        "Headless training run for Contrastive Graph-Neural Stochastic Differential Equations.\n",
        "\n",
        "**Setup**\n",
        "\n",
        "- Clones the repo from GitHub\n",
        "- Downloads preprocessed data artifacts from Kaggle datasets (requires kaggle.json)\n",
        "- Runs training with PyTorch Lightning on GPU\n",
        "\n",
        "**Outputs** land in `/content/vortex-ai/runs/` and can be downloaded from Colab's file browser."
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Environment & Auth"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import sys\n",
        "import subprocess\n",
        "import json\n",
        "\n",
        "print(\"python\", sys.version.split()[0])\n",
        "\n",
        "import torch\n",
        "\n",
        "print(\"torch\", torch.__version__, \"| cuda\", torch.version.cuda)\n",
        "print(\"gpus\", torch.cuda.device_count())\n",
        "if torch.cuda.is_available():\n",
        "    for i in range(torch.cuda.device_count()):\n",
        "        print(\" \", i, torch.cuda.get_device_name(i))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Kaggle Authentication (Required for Data Download)\n",
        "\n",
        "Upload your `kaggle.json` (from https://www.kaggle.com/settings/account) to Colab, then run this cell."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Upload kaggle.json from your local machine\n",
        "from google.colab import files\n",
        "files.upload()  # Select kaggle.json\n",
        "\n",
        "!mkdir -p ~/.kaggle\n",
        "!cp kaggle.json ~/.kaggle/kaggle.json\n",
        "!chmod 600 ~/.kaggle/kaggle.json\n",
        "\n",
        "# Verify\n",
        "!kaggle datasets list -s vortex-ai"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Clone Repository & Install Dependencies"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "REPO_URL = \"https://github.com/yash0238/Vortex-AI.git\"  # Update if different\n",
        "WORK_DIR = \"/content/vortex-ai\"\n",
        "\n",
        "if os.path.exists(WORK_DIR):\n",
        "    import shutil\n",
        "    shutil.rmtree(WORK_DIR)\n",
        "\n",
        "!git clone {REPO_URL} {WORK_DIR}\n",
        "os.chdir(WORK_DIR)\n",
        "print(\"workdir:\", os.getcwd())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Install dependencies\n",
        "REQUIRED = {\n",
        "    \"torch_geometric\": \"torch-geometric\",\n",
        "    \"torchsde\": \"torchsde\",\n",
        "    \"pytorch_lightning\": \"pytorch-lightning\",\n",
        "    \"wandb\": \"wandb\",\n",
        "}\n",
        "\n",
        "missing = []\n",
        "for module, package in REQUIRED.items():\n",
        "    try:\n",
        "        __import__(module)\n",
        "    except ImportError:\n",
        "        missing.append(package)\n",
        "\n",
        "if missing:\n",
        "    print(\"installing:\", missing, flush=True)\n",
        "    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", *missing], check=True)\n",
        "else:\n",
        "    print(\"all dependencies already present\")\n",
        "\n",
        "import pytorch_lightning\n",
        "import torch_geometric\n",
        "import torchsde\n",
        "\n",
        "print(\"torch_geometric\", torch_geometric.__version__)\n",
        "print(\"torchsde\", torchsde.__version__)\n",
        "print(\"pytorch_lightning\", pytorch_lightning.__version__)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Download Data Artifacts from Kaggle\n",
        "\n",
        "Downloads the preprocessed `.npy` artifacts from `brxkeaaryan/vortex-ai-data` dataset."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "DATA_DIR = os.path.join(WORK_DIR, \"Vortex-AI\", \"data\", \"raw\")\n",
        "os.makedirs(DATA_DIR, exist_ok=True)\n",
        "\n",
        "# Download dataset (374 MB)\n",
        "!kaggle datasets download brxkeaaryan/vortex-ai-data -p {DATA_DIR} --unzip\n",
        "\n",
        "# Verify\n",
        "import numpy as np\n",
        "windows = np.load(os.path.join(DATA_DIR, \"windows.npy\"))\n",
        "adj = np.load(os.path.join(DATA_DIR, \"adj_matrices.npy\"))\n",
        "feats = np.load(os.path.join(DATA_DIR, \"window_node_features.npy\"))\n",
        "\n",
        "print(\"windows     \", windows.shape)\n",
        "print(\"adj_matrices\", adj.shape)\n",
        "print(\"node_feats  \", feats.shape)\n",
        "\n",
        "n, T, N = windows.shape\n",
        "assert (T, N) == (60, 50), f\"unexpected window shape {windows.shape}\"\n",
        "assert adj.shape == (n, N, N), f\"unexpected adjacency shape {adj.shape}\"\n",
        "assert feats.shape[1:] == (T, N, 6), f\"unexpected node-feature shape {feats.shape}\"\n",
        "assert feats.shape[0] in (n, n - 1), f\"node-feature length {feats.shape[0]} vs {n} windows\"\n",
        "\n",
        "for name in (\"scaler.npz\", \"split.npz\", \"window_regimes_v2.npy\", \"volume_windows.npy\", \"nifty50_close.csv\"):\n",
        "    assert os.path.exists(os.path.join(DATA_DIR, name)), f\"missing artifact: {name}\"\n",
        "\n",
        "print(f\"OK: {n} windows x {T} days x {N} stocks\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Training Configuration\n",
        "\n",
        "Set `SMOKE = True` for a 2-epoch validation run before committing to full 200 epochs.\n",
        "Colab provides 1 T4 GPU (15 GB VRAM)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "SMOKE = True          # True -> 2-epoch validation run\n",
        "MAX_EPOCHS = 2 if SMOKE else 200\n",
        "BATCH_SIZE = 4\n",
        "NUM_WORKERS = 2\n",
        "RUN_TAG = \"colab_smoke\" if SMOKE else \"colab_t4\"\n",
        "\n",
        "# Optional: Enable wandb (set your API key)\n",
        "# os.environ[\"WANDB_API_KEY\"] = \"your_key_here\"\n",
        "\n",
        "TRAIN_SCRIPT = os.path.join(WORK_DIR, \"Vortex-AI\", \"train_vortex.py\")\n",
        "CONFIG_PATH = os.path.join(WORK_DIR, \"Vortex-AI\", \"training\", \"config.yaml\")\n",
        "\n",
        "cmd = [\n",
        "    \"python\", TRAIN_SCRIPT,\n",
        "    \"--config\", CONFIG_PATH,\n",
        "    \"--accelerator\", \"cuda\",\n",
        "    \"--devices\", \"1\",\n",
        "    \"--max_epochs\", str(MAX_EPOCHS),\n",
        "    \"--batch_size\", str(BATCH_SIZE),\n",
        "    \"--num_workers\", str(NUM_WORKERS),\n",
        "    \"--run_tag\", RUN_TAG,\n",
        "]\n",
        "\n",
        "print(\"$ \" + \" \".join(cmd), flush=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Run Training"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Run training\n",
        "import subprocess\n",
        "result = subprocess.run(cmd, check=True, cwd=os.path.join(WORK_DIR, \"Vortex-AI\"))\n",
        "print(\"Training completed successfully\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Evaluate Best Checkpoint (Skipped in Smoke Mode)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "if SMOKE:\n",
        "    print(\"smoke run: skipping evaluation\")\n",
        "else:\n",
        "    # Find best checkpoint\n",
        "    import glob\n",
        "    ckpts = glob.glob(os.path.join(WORK_DIR, \"Vortex-AI\", \"models\", \"checkpoints\", \"vortex-epoch=*.ckpt\"))\n",
        "    if ckpts:\n",
        "        # Sort by epoch number\n",
        "        ckpts.sort(key=lambda x: int(x.split(\"epoch=\")[1].split(\"-\")[0]))\n",
        "        best_ckpt = ckpts[-1]\n",
        "        print(f\"Best checkpoint: {best_ckpt}\")\n",
        "        \n",
        "        # Run evaluation\n",
        "        eval_cmd = [\n",
        "            \"python\", \n",
        "            os.path.join(WORK_DIR, \"Vortex-AI\", \"evaluate_vortex.py\"),\n",
        "            \"--checkpoint\", best_ckpt,\n",
        "            \"--n_scenarios\", \"500\",\n        "        ]\n",
        "        subprocess.run(eval_cmd, check=True, cwd=os.path.join(WORK_DIR, \"Vortex-AI\"))\n",
        "    else:\n",
        "        print(\"No checkpoints found\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 8. Download Results\n",
        "\n",
        "After training, download checkpoints and logs from Colab's file browser:\n",
        "- `/content/vortex-ai/Vortex-AI/models/checkpoints/`\n",
        "- `/content/vortex-ai/Vortex-AI/runs/`"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Quick: zip results for download\n",
        "!cd /content/vortex-ai && zip -r results.zip Vortex-AI/models/checkpoints Vortex-AI/runs\n",
        "\n",
        "# Download via Colab UI or:\n",
        "from google.colab import files\n",
        "files.download(\"/content/vortex-ai/results.zip\")"
      ]
    }
